# Plaid API Configuration
# Get credentials from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here
PLAID_ENV=sandbox

# OAuth redirect URI for Plaid (required for Chase, Amex, etc.)
# Must match exactly what you register in Plaid Dashboard → API → Allowed redirect URIs
# Example: https://your-app.up.railway.app/plaid/oauth-return
# PLAID_REDIRECT_URI=

# Database Configuration (defaults to SQLite if not set)
# For Railway PostgreSQL: use the DATABASE_URL from the Postgres plugin
# DATABASE_URL=sqlite:///./finance.db

# Simple password gate — set to protect the app when deployed publicly
# Leave empty or unset to disable authentication
# APP_PASSWORD=

# Server Configuration (optional — Railway provides PORT automatically)
# HOST=0.0.0.0
# PORT=8000
